# Common start/stop vars
# EXEC_DIR: where docker-compose runs (certs and compose file are copied there).
# Override it when this repo is on a path snap-confined docker cannot read (e.g. /mnt/hgfs):
#   EXEC_DIR=~/vnap-run ./start-vnap.sh
EXEC_DIR="${EXEC_DIR:-$PWD}"
DIR_NAME="$(echo $EXEC_DIR | awk -F'/' '{print $NF}')"

# systemd unit for the API on the cloud VM: a dedicated account that is the only one in the
# docker group; users reach the service only through the reverse proxy.
#   useradd --system --create-home --groups docker vnap
#   (as vnap: git clone --recurse-submodules <vnap-secure> /home/vnap/vnap-secure; C-ITS-PKI comes with it)
#   cp vnap-api.service /etc/systemd/system/ && systemctl enable --now vnap-api
[Unit]
Description=vnap-secure simulation service (API)
After=docker.service network-online.target
Requires=docker.service

[Service]
User=vnap
Group=vnap
SupplementaryGroups=docker
WorkingDirectory=/home/vnap/vnap-secure/service
ExecStart=/home/vnap/vnap-secure/service/run.sh
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target

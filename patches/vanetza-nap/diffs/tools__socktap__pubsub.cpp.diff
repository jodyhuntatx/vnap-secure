 static std::unordered_map<std::string, int> topic_priority_lookup;
+// guards topic_priority_lookup and subscribers: written by subscribe() on the main thread,
+// read by MQTT/Zenoh/DDS callback threads and the transmission threads
+static std::mutex subscribers_mutex;
+// a boost::asio socket must not be used by several threads at once (processing threads publish)
+static std::mutex udp_mutex;
+
+static int topic_priority(const std::string& topic)
+{
+    std::lock_guard<std::mutex> lock(subscribers_mutex);
+    auto found = topic_priority_lookup.find(topic); // find(): operator[] would insert
+    return found != topic_priority_lookup.end() ? found->second : 0;
+}
 
 
